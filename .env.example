# Copy this file to .env and fill in your values.
# proof-refactor loads the nearest .env automatically.

# Required: API key for the OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Required: base URL of the OpenAI-compatible endpoint.
BASE_URL=

# Optional: model name (default: gemini-3.1-pro-preview).
MODEL=gemini-3.1-pro-preview

# Optional: enable Lean REPL fast path for lean-lsp-mcp.
LEAN_REPL=true
